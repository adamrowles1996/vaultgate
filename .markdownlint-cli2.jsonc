{
  // Prettier owns wrapping (proseWrap: preserve), so line length is not a lint concern.
  "config": {
    "default": true,
    "MD013": false,
    // CHANGELOG sections legitimately repeat "Added" under different releases.
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  // The code sidecar's virtual environment and model download are local, untracked state.
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "sidecars/code/.venv/**",
    "sidecars/code/.model/**",
  ],
}
