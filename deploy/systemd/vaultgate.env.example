# vaultgate configuration for the systemd install: /etc/vaultgate/vaultgate.env
# (owner root, mode 0600; systemd reads it before dropping privileges).
# Full reference: docs/spec/08-configuration.md. Any secret below also accepts
# a <NAME>_FILE path to a file readable only by root.

# The public https origin your reverse proxy serves (docs/guides/reverse-proxy.md).
VAULTGATE_PUBLIC_URL=https://replace-with-your-domain

# install.sh generates this value. Back it up with /var/lib/vaultgate.
VAULTGATE_SECRET_KEY=@SECRET_KEY@

# Bitwarden account: master password and a personal API key (Settings, Security, Keys).
VAULTGATE_BW_PASSWORD=replace-with-your-master-password
VAULTGATE_BW_CLIENT_ID=user.replace-with-your-api-key-client-id
VAULTGATE_BW_CLIENT_SECRET=replace-with-your-api-key-client-secret
# Self-hosted server, Vaultwarden, or bitwarden.eu. Leave unset for bitwarden.com.
#VAULTGATE_BW_SERVER=

# Fixed by the installer: loopback bind behind the proxy, persistent state, CLI path.
VAULTGATE_HOST=127.0.0.1
VAULTGATE_PORT=8080
VAULTGATE_TRUST_PROXY=true
VAULTGATE_DATA_DIR=/var/lib/vaultgate
VAULTGATE_BW_BIN=/usr/local/bin/bw
