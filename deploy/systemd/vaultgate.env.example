# vaultgate configuration for the systemd install: /etc/vaultgate/vaultgate.env
# (owner root, mode 0600; systemd reads it before dropping privileges).
# Full reference: docs/spec/08-configuration.md.
#
# Any secret below also accepts a <NAME>_FILE path. The service reads that file
# as the vaultgate user, so it must be readable by vaultgate and nobody else.
# install.sh creates /etc/vaultgate/secrets (owner vaultgate, mode 0700) for
# them; write each one with, for example:
#   sudo install -m 0600 -o vaultgate -g vaultgate /dev/stdin /etc/vaultgate/secrets/bw_password
# then set VAULTGATE_BW_PASSWORD_FILE=/etc/vaultgate/secrets/bw_password here.

# The public https origin your reverse proxy serves (docs/guides/reverse-proxy.md).
VAULTGATE_PUBLIC_URL=https://replace-with-your-domain

# install.sh generates this value. Back it up with /var/lib/vaultgate.
VAULTGATE_SECRET_KEY=@SECRET_KEY@

# Bitwarden connection. Connect from the account page (Vault connection) after
# the first sign-in: it is stored encrypted in the database and needs no restart.
# The lines below only seed the first boot and are ignored once the account
# page has saved a connection. Set all three or none. VAULTGATE_BW_CLIENT_ID is
# not a secret and has no _FILE form.
#VAULTGATE_BW_PASSWORD=
#VAULTGATE_BW_CLIENT_ID=
#VAULTGATE_BW_CLIENT_SECRET=
# Self-hosted server, Vaultwarden, or bitwarden.eu for the seed. Leave unset for bitwarden.com.
#VAULTGATE_BW_SERVER=

# Fixed by the installer: loopback bind behind the proxy, persistent state, CLI path.
VAULTGATE_HOST=127.0.0.1
VAULTGATE_PORT=8080
VAULTGATE_TRUST_PROXY=true
# Which X-Forwarded-For entry is the client, counted from the right: 1 for one proxy in front (1-10).
VAULTGATE_TRUSTED_PROXY_HOPS=1
VAULTGATE_DATA_DIR=/var/lib/vaultgate
VAULTGATE_BW_BIN=/usr/local/bin/bw
