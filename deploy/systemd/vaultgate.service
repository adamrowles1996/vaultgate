# systemd unit for a bare Linux install (docs/spec/09-deployment.md, DEP-4).
# install.sh copies this file to /etc/systemd/system/vaultgate.service.
[Unit]
Description=vaultgate remote MCP server for Bitwarden
Documentation=https://github.com/adamrowles1996/vaultgate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaultgate
Group=vaultgate
DynamicUser=no
EnvironmentFile=/etc/vaultgate/vaultgate.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/vaultgate/current
ExecStart=/usr/local/bin/node /opt/vaultgate/current/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# Hardening. The process needs the network, its data directory and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/vaultgate
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute stays off: V8's JIT needs writable, executable pages.

[Install]
WantedBy=multi-user.target
