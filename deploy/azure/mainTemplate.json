{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "vaultgate on Azure Container Apps: Log Analytics, a consumption Container Apps environment, a Key Vault holding the secrets, an Azure Files share for /data and the Container App itself. Spec: docs/spec/09-deployment.md section 9.3. The resources are split into linked templates under modules/ (one file per concern); deploy from a URI so that the relative links resolve."
  },
  "parameters": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Base name for every resource (lowercase letters, digits and hyphens; starts with a letter). The Container App is named exactly this."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for every resource." }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Tag of ghcr.io/adamrowles1996/vaultgate to run, for example 1.0.0."
      }
    },
    "publicUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional public origin such as https://vault.example.com once a custom domain is bound. Leave empty to use the generated *.azurecontainerapps.io host."
      }
    },
    "bitwardenServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Bitwarden server: bitwarden.eu or the https:// URL of a self-hosted server or Vaultwarden. Leave empty for bitwarden.com."
      }
    },
    "enableWriteScope": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Allow MCP clients to request the vault:write scope." }
    },
    "logLevel": {
      "type": "string",
      "defaultValue": "info",
      "allowedValues": ["fatal", "error", "warn", "info", "debug", "trace"],
      "metadata": { "description": "VAULTGATE_LOG_LEVEL." }
    },
    "deployCodeSidecar": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Also deploy the code connector's sidecar (Semble code search, ACT-114) as a separate Container App with internal-only ingress, and point VAULTGATE_ACTIONS_CODE_URL at it. The connector stays off until VAULTGATE_ENABLE_ACTIONS and VAULTGATE_ACTIONS_ENABLE_CODE are set."
      }
    },
    "bwPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden master password (stored only in Key Vault). Optional: leave all three Bitwarden values empty to connect the vault on the console's Vault page after the first sign-in."
      }
    },
    "bwClientId": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden personal API key client id (user.…). Optional; set all three Bitwarden values or none."
      }
    },
    "bwClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden personal API key client secret. Optional; set all three Bitwarden values or none."
      }
    },
    "secretKey": {
      "type": "securestring",
      "defaultValue": "[base64(concat(newGuid(), '-', uniqueString(resourceGroup().id, utcNow())))]",
      "metadata": {
        "description": "VAULTGATE_SECRET_KEY: at least 32 bytes as hex or base64 (openssl rand -base64 32). When omitted the template generates one from newGuid() plus uniqueString(); keep it, because a redeployment without the same value rotates the key and forces TOTP re-enrolment."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id, parameters('name'))]",
    "environmentName": "[format('{0}-env', parameters('name'))]",
    "workspaceName": "[format('{0}-logs', parameters('name'))]",
    "identityName": "[format('{0}-identity', parameters('name'))]",
    "keyVaultName": "[format('{0}-{1}', take(parameters('name'), 10), variables('suffix'))]",
    "storageAccountName": "[toLower(format('{0}{1}', take(replace(parameters('name'), '-', ''), 11), variables('suffix')))]",
    "shareName": "vaultgate-data",
    "image": "[format('ghcr.io/adamrowles1996/vaultgate:{0}', parameters('imageTag'))]",
    "platformDeployment": "[format('{0}-platform', parameters('name'))]",
    "secretsDeployment": "[format('{0}-secrets', parameters('name'))]",
    "appDeployment": "[format('{0}-app', parameters('name'))]",
    "codeDeployment": "[format('{0}-code', parameters('name'))]",
    "codeAppName": "[format('{0}-code', parameters('name'))]",
    "codeImage": "[format('ghcr.io/adamrowles1996/vaultgate-code:{0}', parameters('imageTag'))]",
    "hasBitwardenCredentials": "[and(not(empty(parameters('bwPassword'))), not(empty(parameters('bwClientId'))), not(empty(parameters('bwClientSecret'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('platformDeployment')]",
      "properties": {
        "mode": "Incremental",
        "templateLink": { "relativePath": "modules/platform.json" },
        "parameters": {
          "location": { "value": "[parameters('location')]" },
          "workspaceName": { "value": "[variables('workspaceName')]" },
          "environmentName": { "value": "[variables('environmentName')]" },
          "storageAccountName": { "value": "[variables('storageAccountName')]" },
          "shareName": { "value": "[variables('shareName')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('secretsDeployment')]",
      "properties": {
        "mode": "Incremental",
        "templateLink": { "relativePath": "modules/secrets.json" },
        "parameters": {
          "location": { "value": "[parameters('location')]" },
          "keyVaultName": { "value": "[variables('keyVaultName')]" },
          "identityName": { "value": "[variables('identityName')]" },
          "bwPassword": { "value": "[parameters('bwPassword')]" },
          "bwClientId": { "value": "[parameters('bwClientId')]" },
          "bwClientSecret": { "value": "[parameters('bwClientSecret')]" },
          "secretKey": { "value": "[parameters('secretKey')]" },
          "hasBitwardenCredentials": { "value": "[variables('hasBitwardenCredentials')]" }
        }
      }
    },
    {
      "condition": "[parameters('deployCodeSidecar')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('codeDeployment')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', variables('platformDeployment'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": { "relativePath": "modules/code.json" },
        "parameters": {
          "appName": { "value": "[variables('codeAppName')]" },
          "location": { "value": "[parameters('location')]" },
          "environmentId": {
            "value": "[reference(variables('platformDeployment')).outputs.environmentId.value]"
          },
          "image": { "value": "[variables('codeImage')]" }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[variables('appDeployment')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', variables('platformDeployment'))]",
        "[resourceId('Microsoft.Resources/deployments', variables('secretsDeployment'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": { "relativePath": "modules/app.json" },
        "parameters": {
          "appName": { "value": "[parameters('name')]" },
          "location": { "value": "[parameters('location')]" },
          "environmentId": {
            "value": "[reference(variables('platformDeployment')).outputs.environmentId.value]"
          },
          "environmentDefaultDomain": {
            "value": "[reference(variables('platformDeployment')).outputs.environmentDefaultDomain.value]"
          },
          "storageName": { "value": "[variables('shareName')]" },
          "identityId": {
            "value": "[reference(variables('secretsDeployment')).outputs.identityId.value]"
          },
          "keyVaultUri": {
            "value": "[reference(variables('secretsDeployment')).outputs.keyVaultUri.value]"
          },
          "image": { "value": "[variables('image')]" },
          "publicUrl": { "value": "[parameters('publicUrl')]" },
          "bitwardenServer": { "value": "[parameters('bitwardenServer')]" },
          "enableWriteScope": { "value": "[parameters('enableWriteScope')]" },
          "logLevel": { "value": "[parameters('logLevel')]" },
          "codeSidecarHost": {
            "value": "[if(parameters('deployCodeSidecar'), variables('codeAppName'), '')]"
          },
          "hasBitwardenCredentials": { "value": "[variables('hasBitwardenCredentials')]" }
        }
      }
    }
  ],
  "outputs": {
    "appFqdn": {
      "type": "string",
      "value": "[reference(variables('appDeployment')).outputs.fqdn.value]"
    },
    "publicUrl": {
      "type": "string",
      "value": "[reference(variables('appDeployment')).outputs.publicOrigin.value]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "bootstrapInstructions": {
      "type": "string",
      "value": "[format('First run: az containerapp logs show --name {0} --resource-group {1} --tail 200 | grep setup?token= ; open that /setup?token=… URL on {2} within 15 minutes to create the operator account.', parameters('name'), resourceGroup().name, reference(variables('appDeployment')).outputs.publicOrigin.value)]"
    }
  }
}
