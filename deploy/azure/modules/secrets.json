{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Secrets for vaultgate: Key Vault (RBAC, soft delete, purge protection), the secret key and, when all three are supplied, the Bitwarden values, the user-assigned identity the app runs as, and its Key Vault Secrets User role assignment. Linked from ../mainTemplate.json."
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": { "description": "Azure region for every resource." }
    },
    "keyVaultName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": { "description": "Key Vault name (globally unique)." }
    },
    "identityName": {
      "type": "string",
      "metadata": { "description": "User-assigned managed identity name." }
    },
    "bwPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden master password; empty when the account page will supply it."
      }
    },
    "bwClientId": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden personal API key client id; empty when the account page will supply it."
      }
    },
    "bwClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden personal API key client secret; empty when the account page will supply it."
      }
    },
    "hasBitwardenCredentials": {
      "type": "bool",
      "metadata": {
        "description": "Whether all three Bitwarden values were supplied; their Key Vault secrets exist only then."
      }
    },
    "secretKey": {
      "type": "securestring",
      "metadata": { "description": "VAULTGATE_SECRET_KEY." }
    }
  },
  "variables": {
    "keyVaultSecretsUserRole": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "keyVaultId": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
    "identityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
    "secretNames": {
      "bwPassword": "bw-password",
      "bwClientId": "bw-client-id",
      "bwClientSecret": "bw-client-secret",
      "secretKey": "secret-key"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "[parameters('identityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2025-05-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "enablePurgeProtection": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": { "defaultAction": "Allow", "bypass": "AzureServices" }
      }
    },
    {
      "condition": "[parameters('hasBitwardenCredentials')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), variables('secretNames').bwPassword)]",
      "dependsOn": ["[variables('keyVaultId')]"],
      "properties": { "value": "[parameters('bwPassword')]", "contentType": "text/plain" }
    },
    {
      "condition": "[parameters('hasBitwardenCredentials')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), variables('secretNames').bwClientId)]",
      "dependsOn": ["[variables('keyVaultId')]"],
      "properties": { "value": "[parameters('bwClientId')]", "contentType": "text/plain" }
    },
    {
      "condition": "[parameters('hasBitwardenCredentials')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), variables('secretNames').bwClientSecret)]",
      "dependsOn": ["[variables('keyVaultId')]"],
      "properties": { "value": "[parameters('bwClientSecret')]", "contentType": "text/plain" }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), variables('secretNames').secretKey)]",
      "dependsOn": ["[variables('keyVaultId')]"],
      "properties": { "value": "[parameters('secretKey')]", "contentType": "text/plain" }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.KeyVault/vaults/{0}', parameters('keyVaultName'))]",
      "name": "[guid(variables('keyVaultId'), variables('identityId'), variables('keyVaultSecretsUserRole'))]",
      "dependsOn": ["[variables('keyVaultId')]", "[variables('identityId')]"],
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRole')]",
        "principalId": "[reference(variables('identityId')).principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "identityId": {
      "type": "string",
      "value": "[variables('identityId')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(variables('keyVaultId')).vaultUri]"
    }
  }
}
