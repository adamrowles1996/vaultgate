{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  // Non-npm linters installed by mise (.mise.toml), invoked from package.json scripts.
  "ignoreBinaries": [
    "actionlint",
    "editorconfig-checker",
    "gitleaks",
    "hadolint",
    "shellcheck",
    "shfmt",
  ],
  "ignoreDependencies": [],
}
