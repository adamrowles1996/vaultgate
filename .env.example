# Copy to .env for local development (`npm run dev` loads it). Production reads
# the process environment only. Full reference: docs/spec/08-configuration.md.

# Required
VAULTGATE_PUBLIC_URL=http://localhost:8080
VAULTGATE_SECRET_KEY=replace-with-32-random-bytes-in-base64

# Bitwarden connection. The normal way is the console's Vault page, which
# stores it encrypted and needs no restart. These three only seed the first
# boot; once the Vault page has saved a connection they are ignored.
# Set all three or none.
#VAULTGATE_BW_PASSWORD=
#VAULTGATE_BW_CLIENT_ID=
#VAULTGATE_BW_CLIENT_SECRET=

# Optional (defaults shown). Any secret above also accepts a <NAME>_FILE path.
VAULTGATE_HOST=127.0.0.1
VAULTGATE_PORT=8080
VAULTGATE_TRUST_PROXY=false
# With VAULTGATE_TRUST_PROXY, which X-Forwarded-For entry is the client, counted from the right (1-10).
VAULTGATE_TRUSTED_PROXY_HOPS=1
VAULTGATE_ALLOWED_ORIGINS=
VAULTGATE_DATA_DIR=./data
VAULTGATE_BW_SERVER=
VAULTGATE_BW_BIN=bw
VAULTGATE_BW_SYNC_INTERVAL=15m
VAULTGATE_ENABLE_WRITE_SCOPE=false
VAULTGATE_OAUTH_CLIENTS=[]
VAULTGATE_ACCESS_TOKEN_TTL=1h
VAULTGATE_REFRESH_TOKEN_TTL=30d
VAULTGATE_SESSION_TTL=12h
VAULTGATE_AUDIT_RETENTION_DAYS=365
VAULTGATE_SQLITE_NETWORK_FS=false
VAULTGATE_LOG_LEVEL=info

# Actions layer (docs/spec/13-actions.md), off by default: a master switch and one
# switch per connector. VAULTGATE_ACTIONS_BROWSER_CDP_URL (ws:// or wss://, never a
# public address) is required when the browser connector is on, and
# VAULTGATE_ACTIONS_CODE_URL (the code sidecar: http://… or unix:/path, never public)
# when the code connector is on (docs/guides/code-search.md).
#VAULTGATE_ENABLE_ACTIONS=false
#VAULTGATE_ACTIONS_ENABLE_HTTP=false
#VAULTGATE_ACTIONS_ENABLE_SQL=false
#VAULTGATE_ACTIONS_ENABLE_SSH=false
#VAULTGATE_ACTIONS_ENABLE_WINRM=false
#VAULTGATE_ACTIONS_ENABLE_BROWSER=false
#VAULTGATE_ACTIONS_BROWSER_CDP_URL=
#VAULTGATE_ACTIONS_ENABLE_CODE=false
#VAULTGATE_ACTIONS_CODE_URL=http://code:8000
#VAULTGATE_ACTIONS_ALLOW_ANY_COMMAND=false

# Docker Compose only (docs/guides/install-docker-compose.md). Caddy obtains a
# certificate for this hostname; VAULTGATE_PUBLIC_URL must be https://<it>.
# Secrets come from ./secrets/ files there, so the plain secret lines above
# may be deleted; a *_FILE variable always takes precedence.
VAULTGATE_DOMAIN=vault.example.com
# Image tag to run: a release version such as 0.1.0, or latest.
VAULTGATE_VERSION=latest
# The code sidecar's memory limit under `docker compose --profile code` (default 2g).
#VAULTGATE_CODE_MEMORY_LIMIT=2g
